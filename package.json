{
  "name": "prometheus-synth-web-exporter",
  "version": "1.0.0",
  "description": "Synthetic web monitoring for Prometheus",
  "keywords": [
    "cli",
    "daemon",
    "prometheus",
    "exporter",
    "synthetic",
    "web",
    "monitoring"
  ],
  "license": "MIT",
  "repository": "hlsb/prometheus-synth-web-exporter",
  "author": {
    "name": "Dustin Frisch",
    "email": "dustin.frisch@hs-fulda.de"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": "./dist/cli.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node22 --clean",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsup src/cli.ts --format esm --watch",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@optique/core": "^1.3.6",
    "@optique/run": "^1.3.6",
    "@prometheus-io/client": "^0.16.1",
    "consola": "^3.4.2",
    "express": "^5.3.0",
    "parse-duration": "^2.1.9",
    "playwright": "1.63.0",
    "toad-scheduler": "^4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
